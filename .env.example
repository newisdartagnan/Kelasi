# Kelasi — configuration.
#
# Pour un déploiement Docker : copier ce fichier en .env, remplacer
# DB_PASSWORD, puis lancer ./deploy.sh (ou .\deploy.ps1 sous Windows).
#
# Ce fichier sert deux fois : docker compose y lit les ports et le mot de
# passe de la base, et l'application y lit sa propre configuration. Il doit
# donc se trouver à la racine du projet, à côté de docker-compose.yml.

APP_NAME=Kelasi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kelasi
DB_USERNAME=kelasi_user
DB_PASSWORD=kelasi-changez-ce-mot-de-passe

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push web, facultatif : sans ces clés, les rappels restent consultables dans
# l'application mais ne sont pas poussés sur les appareils.
# Les générer avec : docker compose run --rm app php artisan kelasi:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Déploiement Docker
# ---------------------------------------------------------------------------
# Les ports sortent des valeurs habituelles : sous Windows, 80, 443 et 5432
# sont souvent déjà pris et le démarrage échoue sur un message peu parlant.
KELASI_HTTP_PORT=8093
KELASI_DB_PORT=5434
KELASI_ADMINER_PORT=8094

KELASI_DB_NAME=kelasi
KELASI_DB_USER=kelasi_user

# Nombre de jours de sauvegardes conservés par backup.sh.
KELASI_RETENTION_JOURS=30
